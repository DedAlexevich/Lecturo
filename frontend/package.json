{
  "name": "lecturo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:telegram": "node tests/telegram.mjs",
    "test:local": "node --test tests/local-export.test.mjs tests/export-filename.test.mjs tests/local-llm.test.mjs tests/local-gpu.test.mjs tests/transcript-groups.test.mjs tests/menu-placement.test.mjs tests/transcript-sentences.test.mjs tests/quiz-progress.test.mjs",
    "check:comments": "node scripts/check-comments.mjs src",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@mlc-ai/web-llm": "^0.2.86",
    "@tanstack/react-query": "^5.105.0",
    "mediabunny": "^1.61.6",
    "openapi-fetch": "^0.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.64.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0"
  }
}
