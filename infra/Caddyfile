{$SITE_ADDRESS}

encode gzip

@tusd_hooks path /api/v1/uploads/hooks /api/v1/uploads/hooks/*
handle @tusd_hooks {
	respond 404
}

handle /api/* {
	reverse_proxy api:8000
}

handle /files/* {
	request_body {
		max_size 2GB
	}
	reverse_proxy tusd:8080
}

handle_path /media/* {
	root * /srv/storage/videos
	file_server
}

handle {
	reverse_proxy frontend:80
}
