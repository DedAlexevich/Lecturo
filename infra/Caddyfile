{
	log {
		format console
	}
}

{$SITE_ADDRESS}

encode gzip

log

@tusd_hooks path /api/v1/uploads/hooks /api/v1/uploads/hooks/*
handle @tusd_hooks {
	respond 404
}

handle /api/* {
	reverse_proxy api:8000
}

handle /files/* {
	request_body {
		max_size 2GB
	}
	reverse_proxy tusd:8080
}

@media path_regexp media ^/media/([0-9a-f-]{36})\.mp4$
handle @media {
	forward_auth api:8000 {
		uri /api/v1/lectures/{re.media.1}/video-access?{query}
	}
	uri strip_prefix /media
	root * /srv/storage/videos
	file_server
}

handle /media/* {
	respond 404
}

@zoomer_listing path /zoomer/
handle @zoomer_listing {
	header Cache-Control "no-cache"
	root * /srv/zoomer
	uri strip_prefix /zoomer
	file_server browse {
		hide .*
	}
}

@zoomer_clip path_regexp ^/zoomer/[^/]+\.(mp4|webm|MP4|WEBM)$
handle @zoomer_clip {
	header Cache-Control "public, max-age=86400"
	root * /srv/zoomer
	uri strip_prefix /zoomer
	file_server {
		hide .*
	}
}

@zoomer_other path /zoomer /zoomer/*
handle @zoomer_other {
	respond 404
}

handle {
	reverse_proxy frontend:80
}
